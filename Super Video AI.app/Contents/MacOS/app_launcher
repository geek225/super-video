#!/usr/bin/env bash
# ==============================================================================
# Lanceur natif macOS Desktop pour Super Video AI
# Ouvre une vraie fenêtre d'application macOS (PyWebView) sans navigateur web
# ==============================================================================

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

BUNDLE_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
APP_DIR="$(cd "$BUNDLE_DIR/.." && pwd)"
cd "$APP_DIR"

# 1. Vérification et initialisation de l'environnement virtuel Python + PyWebView
if [ ! -d ".venv" ]; then
    python3 -m venv .venv
    "$APP_DIR/.venv/bin/pip" install -r requirements.txt
else
    "$APP_DIR/.venv/bin/python" -c "import webview, uvicorn, fastapi" 2>/dev/null || "$APP_DIR/.venv/bin/pip" install -r requirements.txt
fi

# 2. Synchronisation automatique silencieuse depuis GitHub
if [ -d ".git" ]; then
    git pull origin main --quiet 2>/dev/null || true
fi

# 3. Création du fichier .env à partir de l'exemple si absent
if [ ! -f ".env" ] && [ -f ".env.example" ]; then
    cp .env.example .env
fi

# 4. Lancement de la fenêtre Desktop native Super Video AI
exec "$APP_DIR/.venv/bin/python" "$APP_DIR/desktop.py"
