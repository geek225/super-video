#!/usr/bin/env bash
# ==============================================================================
# Lanceur natif macOS Desktop Autonome pour Super Video AI (Méthode A)
# Installe automatiquement un moteur Python portable si Python est absent du Mac
# ==============================================================================

export PATH="/opt/homebrew/bin:/usr/local/bin:/Library/Frameworks/Python.framework/Versions/Current/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

BUNDLE_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
APP_DIR="$(cd "$BUNDLE_DIR/.." && pwd)"
cd "$APP_DIR"

# 1. Créer le fichier .env à partir de l'exemple si absent
if [ ! -f ".env" ] && [ -f ".env.example" ]; then
    cp .env.example .env
fi

# 2. Trouver un interpréteur Python 3 valide sans déclencher la popup Xcode d'Apple
find_system_python() {
    for candidate in "/opt/homebrew/bin/python3" "/usr/local/bin/python3" "/Library/Frameworks/Python.framework/Versions/Current/bin/python3"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    if xcode-select -p >/dev/null 2>&1 && [ -x "/usr/bin/python3" ]; then
        echo "/usr/bin/python3"
        return 0
    fi
    return 1
}

# 3. Initialiser automatiquement l'environnement (.venv) ou télécharger un moteur Python portable
if [ ! -x "$APP_DIR/.venv/bin/python" ] || ! "$APP_DIR/.venv/bin/python" -c "import webview, uvicorn, fastapi" >/dev/null 2>&1; then
    osascript -e 'display notification "Préparation automatique de votre Studio (1ère ouverture)..." with title "Super Video AI" subtitle "Vibe coder par Stéphane Kevin Assamoi"' >/dev/null 2>&1 || true

    SYS_PY="$(find_system_python || true)"
    if [ -n "$SYS_PY" ]; then
        if [ ! -d ".venv" ]; then
            "$SYS_PY" -m venv .venv
        fi
        "$APP_DIR/.venv/bin/pip" install --upgrade pip >/dev/null 2>&1 || true
        "$APP_DIR/.venv/bin/pip" install -r requirements.txt
    else
        # Aucun Python sur le Mac : Téléchargement automatique d'un moteur Python 3.11 portable via uv
        mkdir -p "$APP_DIR/.runtime"
        export UV_INSTALL_DIR="$APP_DIR/.runtime/bin"
        export UV_PYTHON_INSTALL_DIR="$APP_DIR/.runtime/python"
        if [ ! -x "$UV_INSTALL_DIR/uv" ]; then
            curl -LsSf https://astral.sh/uv/install.sh | sh
        fi
        "$UV_INSTALL_DIR/uv" venv --python 3.11 "$APP_DIR/.venv"
        "$UV_INSTALL_DIR/uv" pip install -r requirements.txt --python "$APP_DIR/.venv/bin/python"
    fi
fi

# 4. Lancement de la fenêtre Desktop native Super Video AI
exec "$APP_DIR/.venv/bin/python" "$APP_DIR/desktop.py"
